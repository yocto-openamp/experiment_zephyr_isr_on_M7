#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		/* Shared memory reserved for inter-processor communication. */
		zephyr,ipc_shm = &shram;
		zephyr,ipc = &mailbox0;
	};

	shram: memory@55000000 {
		compatible = "mmio-sram";
		reg = <0x55000000 0x500000>;
	};

	zephyr,user {
		gpio-direct-in-gpios = <&gpio3 9 GPIO_ACTIVE_HIGH>;
		gpio-direct-out-gpios = <&gpio3 13 GPIO_ACTIVE_HIGH>;

		/* nucleo_f722ze.dts: sw0 = &user_button */
		gpio-direct-button-in-gpios = <&gpio3 14 GPIO_ACTIVE_HIGH>;
		/* led1 = &blue_led */
		gpio-direct-led-out-gpios = <&gpio3 13 GPIO_ACTIVE_HIGH>;
	};
};

/ {
	leds {
		compatible = "gpio-leds";

		user_led: user_led {
			label = "User LED";
			gpios = <&gpio3 5 GPIO_ACTIVE_HIGH>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		user_button: user_button {
			label = "User Button";
			gpios = <&gpio3 12 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &user_led;
		sw0 = &user_button;
	};
};

&uart4 {
	status = "okay";
	current-speed = <115200>;
};


/*
See also:
zephyr/boards/st/nucleo_f722ze/nucleo_f722ze.dts
*/

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	zephyr,user {
		gpio-hal-in-gpios = <&gpiog 9 GPIO_ACTIVE_HIGH>;
		gpio-hal-out-gpios = <&gpiog 14 GPIO_ACTIVE_HIGH>;

		gpio-direct-in-gpios = <&gpiof 15 GPIO_ACTIVE_HIGH>;
		gpio-direct-out-gpios = <&gpioe 13 GPIO_ACTIVE_HIGH>;

		/* nucleo_f722ze.dts: sw0 = &user_button */
		gpio-direct-button-in-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
		/* led1 = &blue_led */
		gpio-direct-led-out-gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
	};
};

&adc2 {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <2>;
	status = "okay";
};

&adc3 {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <2>;
	status = "okay";
};

&dac1 {
	status = "okay";
	/* DAC2 (channel 2 of dac1) is also enabled */
};
